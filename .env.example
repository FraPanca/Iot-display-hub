# MQTT, credenziali utente display-server (vedi mosquitto/config/aclfile)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=display-server
MQTT_PASSWORD=

# Device id
DISPLAY_ID=cyd-01

# MongoDB, credenziali root del container
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=iot-display-hub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Meteo, non richiesta da Open-Meteo, riservata per eventuale cambio provider futuro
WEATHER_API_KEY=

# Coordinate per Open-Meteo, sostituire con la posizione reale del display
WEATHER_LAT=41.9028
WEATHER_LON=12.4964

# Spotify, ottenute allo step SPOTIFY-SETUP
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Porta interna del backend
PORT=3000