[Unit]
Description=IoT Display Hub - stack Docker (Mosquitto, MongoDB, Redis, Server)
RequiresMountsFor=/mnt/wd1tb

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/francesco/iot-display-hub
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target