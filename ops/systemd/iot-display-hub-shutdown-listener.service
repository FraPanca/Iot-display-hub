[Unit]
Description=IoT Display Hub - listener shutdown MQTT (host)
After=network-online.target iot-display-hub-docker.service
Wants=network-online.target iot-display-hub-docker.service

[Service]
Type=simple
User=francesco
ExecStart=/home/francesco/iot-display-hub/ops/scripts/shutdown_listener.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target